# ── Database ───────────────────────────────────────────────────
# Local dev:  postgresql://user:password@localhost:5432/stockradar
# Docker:     postgresql://stockradar:${DB_PASSWORD}@postgres:5432/stockradar
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/stockradar

# ── JWT Auth ───────────────────────────────────────────────────
SECRET_KEY=change-me-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# ── Email weekly report (optional) ────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=report@stockradar.example.com
EMAIL_ADMIN=admin@stockradar.example.com

# ── App ────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Scraper defaults ───────────────────────────────────────────
MIN_AVG_VOL=2000          # minimum 20-day average volume (lots)
MIN_CHIP_CONC=40.0        # minimum chip concentration (%)
TDCC_REQUEST_DELAY=1.5    # delay between TDCC requests (seconds)
