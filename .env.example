# ── Database ───────────────────────────────────────────────────
# Generate with: openssl rand -hex 24
# Use -hex, NOT -base64: this value is interpolated into DATABASE_URL
# (postgresql://stockradar:<pw>@postgres:5432/...) and base64 output can
# contain "/" or "+", which breaks URL parsing.
DB_PASSWORD=change-me

# ── JWT Auth ───────────────────────────────────────────────────
# Strong random key recommended: openssl rand -base64 48
SECRET_KEY=change-me-use-a-long-random-string

# ── Production only ────────────────────────────────────────────
# Your domain (without https://). Caddy uses this for auto TLS.
DOMAIN=stockradar.example.com
# Email address for Let's Encrypt certificate notifications
TLS_EMAIL=your@email.com

# ── Email (optional, but see the note below) ──────────────────
# Used for two things: the weekly digest, and account notifications
# (someone applied for an account / your account was approved).
#
# Pick ONE of the two channels. Resend is tried first; SMTP is the fallback.
# With neither set, mail is skipped — the app logs a warning and carries on,
# so approving an account still works, the applicant just never hears about it.

# Channel 1: Resend (https://resend.com — free tier is enough)
RESEND_API_KEY=re_...

# Channel 2: Gmail SMTP. SMTP_PASS is an app password, NOT your Google password
# (Google Account → Security → 2-Step Verification → App passwords).
# Paste the 16 characters with no spaces.
SMTP_USER=you@gmail.com
SMTP_PASS=abcdefghijklmnop

EMAIL_FROM=report@stockradar.example.com
# Fallback recipient for admin notices when no admin account has an email
EMAIL_ADMIN=admin@stockradar.example.com

# ── App ────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Scraper defaults (adjustable in the UI too) ───────────────
MIN_AVG_VOL=2000      # minimum 20-day average volume (lots)
MIN_CHIP_CONC=40.0    # minimum chip concentration (%)
TDCC_REQUEST_DELAY=1.5  # delay between TDCC requests (seconds)
