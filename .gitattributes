# Default: normalize line endings to LF in the repo
* text=auto eol=lf

# Shell scripts must be LF (bash breaks with CRLF)
*.sh text eol=lf

# Windows batch files use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — no conversion
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff2 binary
*.woff binary
